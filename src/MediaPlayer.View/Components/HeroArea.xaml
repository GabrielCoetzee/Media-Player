<UserControl x:Class="MediaPlayer.View.Components.HeroArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:MediaPlayer.View.Components"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,8">
            <components:AlbumArtDisplay Visibility="{Binding QueueViewModel.SelectedMediaItem.IsAudio, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <vlc:VideoView x:Name="VlcVideoView"
                           Visibility="{Binding QueueViewModel.SelectedMediaItem.IsVideo, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                           MediaPlayer="{Binding MediaControlsViewModel.AudioEngine.NativePlayer}" />
        </Grid>

        <components:NowPlayingMetadata Grid.Row="1" Margin="16,8,16,16" />
    </Grid>
</UserControl>
