<UserControl x:Class="MediaPlayer.View.Components.TransportBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:MediaPlayer.View.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <ui:Button Appearance="Transparent"
                       Margin="2,0"
                       Padding="8"
                       ToolTip="Previous"
                       Command="{Binding MediaControlsViewModel.PreviousTrackCommand}"
                       CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="Previous24" />
            </ui:Button>

            <ui:Button Appearance="Primary"
                       Margin="4,0"
                       Padding="12,8"
                       ToolTip="Play/Pause (Space)"
                       Command="{Binding MediaControlsViewModel.PlayPauseCommand}"
                       CommandParameter="{Binding}">
                <ui:SymbolIcon FontSize="20">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="{x:Type ui:SymbolIcon}">
                            <Setter Property="Symbol" Value="Play24" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MediaControlsViewModel.MediaState}" Value="Play">
                                    <Setter Property="Symbol" Value="Pause24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </ui:Button>

            <ui:Button Appearance="Transparent"
                       Margin="2,0"
                       Padding="8"
                       ToolTip="Stop"
                       Command="{Binding MediaControlsViewModel.StopCommand}"
                       CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="Stop24" />
            </ui:Button>

            <ui:Button Appearance="Transparent"
                       Margin="2,0"
                       Padding="8"
                       ToolTip="Next"
                       Command="{Binding MediaControlsViewModel.NextTrackCommand}"
                       CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="Next24" />
            </ui:Button>
        </StackPanel>

        <components:SeekStrip Grid.Column="1"
                              Margin="24,0"
                              VerticalAlignment="Center" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <ToggleButton Margin="2,0"
                          Padding="6"
                          ToolTip="Shuffle"
                          IsChecked="{Binding MediaControlsViewModel.IsShuffled, Mode=OneWay}"
                          Command="{Binding MediaControlsViewModel.ShuffleCommand}"
                          CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="ArrowShuffle24" />
            </ToggleButton>

            <ToggleButton Margin="2,0"
                          Padding="6"
                          ToolTip="Repeat"
                          IsChecked="{Binding MediaControlsViewModel.IsRepeatEnabled, Mode=OneWay}"
                          Command="{Binding MediaControlsViewModel.RepeatMediaListCommand}"
                          CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
            </ToggleButton>

            <components:VolumeControl Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
