<UserControl x:Class="MediaPlayer.View.Components.PlayerShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:MediaPlayer.View.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="ShellRoot">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,12,4">
            <ToggleButton x:Name="LyricsToggle"
                          Margin="2,0"
                          ToolTip="Toggle lyrics (Ctrl+L)"
                          IsChecked="{Binding IsLyricsOpen, ElementName=ShellRoot, Mode=TwoWay}">
                <ui:SymbolIcon Symbol="Notepad24" />
            </ToggleButton>
            <ToggleButton x:Name="QueueToggle"
                          Margin="2,0"
                          ToolTip="Toggle queue (Ctrl+Q)"
                          IsChecked="{Binding IsQueueOpen, ElementName=ShellRoot, Mode=TwoWay}">
                <ui:SymbolIcon Symbol="AppsListDetail24" />
            </ToggleButton>
            <ui:Button x:Name="SettingsButton"
                       Margin="2,0"
                       Appearance="Transparent"
                       ToolTip="Settings"
                       Icon="{ui:SymbolIcon Settings24}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="320"
                    Margin="8,0,4,0"
                    Visibility="{Binding IsLyricsOpen, ElementName=ShellRoot, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        Padding="12">
                    <TextBlock Text="LyricsPanel placeholder (step 9)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Border>

            <Grid Grid.Column="1" Margin="4,0">
                <components:EmptyState>
                    <components:EmptyState.Style>
                        <Style TargetType="{x:Type components:EmptyState}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMediaListPopulated}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:EmptyState.Style>
                </components:EmptyState>

                <components:HeroArea Visibility="{Binding IsMediaListPopulated, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Border Grid.Column="2"
                    Width="320"
                    Margin="4,0,8,0"
                    Visibility="{Binding IsQueueOpen, ElementName=ShellRoot, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        Padding="12">
                    <TextBlock Text="QueuePanel placeholder (step 8)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,12"
                Margin="0,8,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <components:TransportBar />
        </Border>
    </Grid>
</UserControl>
