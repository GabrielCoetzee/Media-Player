<UserControl x:Class="MediaPlayer.View.Components.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:enums="clr-namespace:MediaPlayer.Common.Enumerations;assembly=MediaPlayer.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="360">
    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            Padding="0">
        <StackPanel Margin="16,12">
            <ui:TextBlock FontTypography="Subtitle"
                          Margin="0,0,0,8"
                          Text="Settings" />

            <ui:CardExpander Margin="0,4"
                             IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="PaintBrush24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Appearance" />
                </ui:CardExpander.Header>

                <StackPanel Margin="0,4">
                    <Grid Margin="0,4">
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="Dark mode" />
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding ThemeViewModel.UseDarkMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="Auto-adjust accent from album art" />
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding ThemeViewModel.AutoAdjustAccent, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="Window backdrop" />
                        <ComboBox HorizontalAlignment="Right"
                                  MinWidth="140"
                                  IsEnabled="{Binding ThemeViewModel.IsBackdropSupported}"
                                  SelectedValue="{Binding ThemeViewModel.BackdropType, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="None"     Tag="{x:Static enums:DwmBackdropType.None}" />
                            <ComboBoxItem Content="Mica"     Tag="{x:Static enums:DwmBackdropType.Mica}" />
                            <ComboBoxItem Content="Acrylic"  Tag="{x:Static enums:DwmBackdropType.Acrylic}" />
                            <ComboBoxItem Content="Tabbed"   Tag="{x:Static enums:DwmBackdropType.Tabbed}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,4"
                             IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Tag24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Metadata" />
                </ui:CardExpander.Header>

                <StackPanel Margin="0,4">
                    <Grid Margin="0,4">
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="Auto-update metadata from online sources" />
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding UpdateMetadata, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="Save metadata back to file" />
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding SaveMetadataToFile, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </Border>
</UserControl>
