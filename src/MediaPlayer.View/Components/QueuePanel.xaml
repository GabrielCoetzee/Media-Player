<UserControl x:Class="MediaPlayer.View.Components.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:MediaPlayer.View.Behaviors"
             xmlns:converters="clr-namespace:MediaPlayer.View.Converters"
             xmlns:genericControls="clr-namespace:Generic.Controls;assembly=Generic"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:RemoveMediaItemMultiValueConverter x:Key="RemoveMediaItemConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,8,8,8">
            <ui:TextBlock VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Text="{Binding BusyViewModel.MediaListTitle, FallbackValue='Queue'}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ProgressRing Margin="4,0"
                                 Width="16" Height="16"
                                 IsIndeterminate="True"
                                 Visibility="{Binding BusyViewModel.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

                <ui:Button Margin="2,0"
                           Padding="6"
                           Appearance="Transparent"
                           ToolTip="Add files (Ctrl+O)"
                           Command="{Binding MediaControlsViewModel.AddMediaCommand}"
                           Icon="{ui:SymbolIcon Add24}" />

                <ui:DropDownButton Margin="2,0"
                                   Padding="6"
                                   Appearance="Transparent"
                                   ToolTip="More"
                                   Icon="{ui:SymbolIcon MoreHorizontal24}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="Clear all"
                                      Command="{Binding MediaControlsViewModel.ClearMediaListCommand}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>
        </Grid>

        <genericControls:AutoScrollListView Grid.Row="1"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            ItemsSource="{Binding MediaItems}"
                                            SelectedItem="{Binding SelectedMediaItem, Mode=TwoWay}"
                                            SelectionMode="Single"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            behaviors:ListBoxDragReorderBehavior.Enabled="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="4"
                                Margin="0,0,8,0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ui:SymbolIcon Symbol="MusicNote124"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Artist, FallbackValue=''}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:00}:{1:00}" FallbackValue="--:--">
                                    <Binding Path="Duration.Minutes" />
                                    <Binding Path="Duration.Seconds" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <ui:Button Grid.Column="3"
                                   Margin="2,0,0,0"
                                   Padding="4"
                                   Appearance="Transparent"
                                   ToolTip="Remove"
                                   Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Icon="{ui:SymbolIcon Dismiss12}">
                            <ui:Button.CommandParameter>
                                <MultiBinding Converter="{StaticResource RemoveMediaItemConverter}">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    <Binding />
                                </MultiBinding>
                            </ui:Button.CommandParameter>
                        </ui:Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </genericControls:AutoScrollListView>
    </Grid>
</UserControl>
